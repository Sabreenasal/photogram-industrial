<p style="color: green"><%= notice %></p>

<%= render @comment %>


<div class="mt-3">
  <%= link_to "Edit this comment", edit_comment_path(@comment), class: "btn btn-outline-secondary" %> |
  <%= link_to "Back to comments", comments_path, class: "btn btn-outline-primary" %>
  <%= button_to "Destroy this comment", @comment, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger" %>
</div>
