<div class="card d-flex mb-3">
  <div class="card-body">
    <div class="d-flex align-items-start">
      <% if comment.author.avatar_image_url.present? %>
        <%= image_tag comment.author.avatar_image_url, class: "rounded-circle me-2 img-cover img-small" %>
      <% end %>

      <div class="w-100">
        <div class="d-flex justify-content-between">
          <strong>
            <%= link_to comment.author.username, user_path(comment.author.username), class: "text-dark text-decoration-none" %>
          </strong>

          <div>
            <%= link_to edit_comment_path(comment), class: "btn btn-link btn-sm text-muted" do %>
              <i class="fas fa-edit fa-fw"></i>
            <% end %>

            <%= button_to comment_path(comment), method: :delete, class: "btn btn-link btn-sm text-muted" do %>
              <i class="fas fa-trash fa-fw"></i>
            <% end %>
          </div>
        </div>
        <p class="mt-2 mb-0"><%= comment.body %></p>
      </div>
    </div>
  </div>
</div>
