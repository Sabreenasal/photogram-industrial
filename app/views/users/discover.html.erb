<% shown_photo_ids = Set.new %>

<div class="row">
  <div class="col-md-6 offset-3">
    <h1>discover</h1>
    <p>posts liked by people you follow
      <p>
      </div>
    </div>

    <ul>
      <% @user.leaders.each do |leader| %>
        <% leader.liked_photos.each do |photo| %>
          <% unless shown_photo_ids.include?(photo.id) %>
            <%= render "photos/photo", photo: photo %>
            <% shown_photo_ids.add(photo.id) %>
          <% end %>
        <% end %>
      <% end %>
    </ul>
