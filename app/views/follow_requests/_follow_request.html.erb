<div id="<%= dom_id follow_request %>">
  <p><strong>Recipient:</strong> <%= follow_request.recipient_id %></p>
  <p><strong>Sender:</strong> <%= follow_request.sender_id %></p>
  <p><strong>Status:</strong> <%= follow_request.status %></p>

  <% if follow_request.status == 'pending' %>
    <%= button_to 'Accept', accept_follow_request_path(follow_request), method: :patch, class: "btn btn-success" %>
    <%= button_to 'Decline', decline_follow_request_path(follow_request), method: :patch, class: "btn btn-danger" %>
  <% end %>
</div>


