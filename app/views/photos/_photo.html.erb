<div class="row mb-4">
  <div class="col-md-6 offset-md-3">
    <div class="card">
      <%= image_tag photo.image_url, class: "card-img-top" %>
      <div class="card-body">
        <h5 class="card-title"><%= photo.owner.username %></h5>
        <p class="card-text"><%= photo.caption %></p>
      </div>
     
      <div class="card-body">
        <%= render "comments/form", comment: photo.comments.build %>
      </div>
    </div>
  </div>
</div>
