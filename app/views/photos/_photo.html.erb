<div class="row mb-4">
  <div class="col-md-6 offset-md-3">
    <div class="card">
      <%= image_tag photo.image_url, class: "card-img-top" %>

      <div class="card-body">
        <% if current_user == photo.owner %>
          <div class="text-end">
            <%= button_to photo_path(photo), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-link btn-sm text-danger p-0", form: { "data-turbo-confirm": "Are you sure?" } do %>
              <i class="fa fa-trash"></i>
            <% end %>
          </div>
        <% end %>

        <h5 class="card-title"><%= photo.owner.username %></h5>
        <p class="card-text"><%= photo.caption %></p>

        <hr>

        <% photo.comments.each do |comment| %>

          <div class="card my-2 ms-2">
            <div class="card-body py-2 px-3">
              <p class="card-text mb-1">
                <strong><%= comment.author.username if comment.author %>:</strong> <%= comment.body %>
              </p>
              <div>

                <%= link_to "Edit", edit_comment_path(comment), class: "btn btn-sm btn-outline-secondary" %>
                <%= button_to "Delete", comment_path(comment), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger" %>
              </div>
            </div>
          </div>
        <% end %>

        <div  class="mt-3 ms-2">
          <%= render "comments/form", comment: photo.comments.build %>
        </div>
      </div>
    </div>
  </div>
